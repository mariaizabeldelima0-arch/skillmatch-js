//Cálculo de compatibilidade do candidato com as vagas
function calcularCompatibilidade(candidatoHabilidades, vagaRequisitos) {
  const encontradas = candidatoHabilidades.filter(h => vagaRequisitos.includes(h)
  );

  const totalEncontradas = encontradas.length;

  const totalRequisitos = vagaRequisitos.length;

  const percentual = (totalEncontradas / totalRequisitos) * 100;

  const faltantes = vagaRequisitos.filter(r =>
    !candidatoHabilidades.includes(r)
  );

  return {
    percentual: Math.round(percentual),
    encontradas: encontradas,
    faltantes: faltantes
  };
}

function classificarCompatibilidade(percentual) {
  if (percentual >= 80) {
    return "Alta Compatibilidade";
  }
  else if (percentual >= 50) {
    return "Média Compatibilidade";
  }
  else {
    return "Baixa Compatibilidade";
  }
}

function listarHabilidadesFaltantes(candidatoHabilidades, vagaRequisitos) {
  const faltantes = vagaRequisitos.filter(r =>
    !candidatoHabilidades.includes(r)
  );
  return faltantes;
}

function encontrarMelhorVaga(candidato, vagas) {

  const analises = vagas.map(vaga =>
    calcularCompatibilidade(candidato.habilidades, vaga.requisitos)
  );

  const melhorAnalise = analises.reduce((melhor, atual) =>
    atual.percentual > melhor.percentual ? atual : melhor
  );

  return melhorAnalise;
}

function gerarRecomendacaoEstudo(candidato, vagas) {

  const todasAsAnalises = vagas.map(vaga =>
    calcularCompatibilidade(candidato.habilidades, vaga.requisitos)
  );

  const recomendacoes = [];

  todasAsAnalises.forEach(analise => {
    analise.faltantes.forEach(faltante => {
      if (!recomendacoes.includes(faltante)) {
        recomendacoes.push(faltante);
      }
    });
  });

  return recomendacoes;

}

class Vaga {
  constructor(empresa, cargo, requisitos, salario, beneficio, modalidade) {
    this.empresa = empresa;
    this.cargo = cargo;
    this.requisitos = requisitos;
    this.salario = salario;
    this.beneficio = beneficio;
    this.modalidade = modalidade;
  }

  exibirResumo() {
    return `${this.cargo} na empresa ${this.empresa}`;
  }
}

class VagaFrontEnd extends Vaga {
  constructor(empresa, cargo, requisitos, salario, beneficio, modalidade, nivel) {
    super(empresa, cargo, requisitos, salario, beneficio, modalidade);
    this.nivel = nivel;
  }

  exibirNivel() {
    return `Nível da vaga: ${this.nivel}`;
  }
}