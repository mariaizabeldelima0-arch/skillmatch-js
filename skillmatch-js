// RF14 – USAR PROMISE E ASYNC/AWAIT
// Conceitos usados: PROMISE; RESOLVE; SETTIMEOUT
function buscarVagasSimuladas() {
  return new Promise((resolve) => { // PROMISE | RESOLVE | CALLBACK
    setTimeout(() => { // SETTIMEOUT - espera 2 segundos
      resolve(vagas);
    }, 2000);
  });
}

// Conceitos usados: ASYNC; AWAIT; TRY/CATCH
async function iniciarSistema() { // ASYNC - trabalha com Promises
  console.log("Carregando vagas...");
  try { // TRY - tenta executar
    const vagasCarregadas = await buscarVagasSimuladas(); // AWAIT - espera Promise
    console.log("✅ Vagas carregadas com sucesso!");
    console.log(vagasCarregadas.length + " vagas disponíveis"); // OPERADOR (+)
  } catch (erro) { // CATCH - trata erro
    console.log("❌ Erro ao carregar vagas:", erro);
  }
}