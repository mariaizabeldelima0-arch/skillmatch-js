// RF13 – USAR CLOSURE
// Conceitos usados: CLOSURE; LET; ESCOPO; INCREMENTO (++)
function criarContadorDeAnalises() {
  let total = 0; // LET - variável privada (ESCOPO)
  return function () { // RETURN | CLOSURE - função que lembra de total
    total++; // INCREMENTO (++)
    return total;
  };
}

