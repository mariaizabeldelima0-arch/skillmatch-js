// RF03 – CALCULAR COMPATIBILIDADE
// Conceitos usados: FUNÇÃO; PARÂMETROS; FILTER; ARROW FUNCTIONS; INCLUDES; OPERADORES MATEMÁTICOS; OPERADOR LÓGICO (!)
function calcularCompatibilidade(candidatoHabilidades, vagaRequisitos) { // FUNÇÃO com 2 PARÂMETROS
  const encontradas = candidatoHabilidades.filter(h => vagaRequisitos.includes(h)); // FILTER | ARROW FUNCTION (=>) | INCLUDES
  const totalEncontradas = encontradas.length; // PROPRIEDADE length
  const totalRequisitos = vagaRequisitos.length;
  const percentual = (totalEncontradas / totalRequisitos) * 100; // OPERADOR MATEMÁTICO (/, *)
  const faltantes = vagaRequisitos.filter(r => !candidatoHabilidades.includes(r)); // OPERADOR LÓGICO (!)
  return { // RETURN | OBJETO
    percentual: Math.round(percentual), // Math.round
    encontradas: encontradas,
    faltantes: faltantes
  };
}

// RF04 – CLASSIFICAR COMPATIBILIDADE
// Conceitos usados: IF/ELSE; OPERADOR DE COMPARAÇÃO (>=)
function classificarCompatibilidade(percentual) {
  if (percentual >= 80) { // IF | OPERADOR DE COMPARAÇÃO (>=)
    return "Alta Compatibilidade";
  } else if (percentual >= 50) { // ELSE IF
    return "Média Compatibilidade";
  } else { // ELSE
    return "Baixa Compatibilidade";
  }
}

// RF05 – LISTAR HABILIDADES FALTANTES
// Conceitos usados: FILTER; OPERADOR LÓGICO (!); INCLUDES
function listarHabilidadesFaltantes(candidatoHabilidades, vagaRequisitos) {
  const faltantes = vagaRequisitos.filter(r => !candidatoHabilidades.includes(r));
  return faltantes;
}

// RF06 – ENCONTRAR A VAGA COM MAIOR COMPATIBILIDADE
// Conceitos usados: MAP; REDUCE; OPERADOR TERNÁRIO (?:); OPERADOR DE COMPARAÇÃO (>)
function encontrarMelhorVaga(candidato, vagas) {
  const analises = vagas.map(vaga => calcularCompatibilidade(candidato.habilidades, vaga.requisitos)); // MAP | FUNCTION CALL
  const melhorAnalise = analises.reduce((melhor, atual) => // REDUCE
    atual.percentual > melhor.percentual ? atual : melhor // OPERADOR TERNÁRIO (?:) | OPERADOR (>)
  );
  return melhorAnalise;
}

// RF07 – GERAR RECOMENDAÇÃO DE ESTUDO
// Conceitos usados: MAP; FOREACH; IF; PUSH
function gerarRecomendacaoEstudo(candidato, vagas) {
  const todasAsAnalises = vagas.map(vaga => calcularCompatibilidade(candidato.habilidades, vaga.requisitos));
  const recomendacoes = []; // ARRAY VAZIO
  todasAsAnalises.forEach(analise => { // FOREACH
    analise.faltantes.forEach(faltante => {
      if (!recomendacoes.includes(faltante)) { // IF
        recomendacoes.push(faltante); // PUSH
      }
    });
  });
  return recomendacoes;
}

